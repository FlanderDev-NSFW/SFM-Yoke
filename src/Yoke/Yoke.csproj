<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(RepoRoot)build\SfmMod.props" />

  <PropertyGroup>
    <AssemblyName>Yoke</AssemblyName>
    <RootNamespace>Yoke</RootNamespace>
    <Version>0.1.0</Version>
    <Description>Yoke - a neck and wrist yoke for SecretFlasherManaka (BepInEx IL2CPP)</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.UI"><HintPath>$(SfmInterop)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(SfmInterop)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <!-- The model, exported from Yoke_V1.1_Z88OaNZ.blend by tools/export_model.py (see README). -->
    <EmbeddedResource Include="assets\yoke.ykm" LogicalName="Yoke.assets.yoke.ykm" />
  </ItemGroup>

  <!-- Compile the shared SfmKit sources into this DLL. -->
  <Import Project="$(RepoRoot)build\SfmKit.props" />
  <Import Project="$(RepoRoot)build\SfmMod.targets" />
</Project>
